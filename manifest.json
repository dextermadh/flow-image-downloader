{
  "manifest_version": 3,
  "name": "Google Flow 2K Bulk Downloader",
  "version": "0.1.0",
  "description": "Automates bulk 2K upscaled image downloads on Google Flow (labs.google/fx).",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://flow.google/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow 2K Bulk Downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://flow.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
